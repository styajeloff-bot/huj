# Copy to full_import.env and fill values after you open DB tunnels yourself.
# The real full_import.env is ignored by git.

# Absolute path to the generated bundle that contains:
#   postgres/load.sql
#   clickhouse/data/*.jsonl
FULL_IMPORT_BUNDLE_DIR="/Users/a_belianskii/projects/carcraft-leadgenerator/leasing_export/import/full_bulk_sql"

# Human label printed in logs, for example "test", "stage", "prod".
FULL_IMPORT_TARGET_LABEL="CHANGE_ME"

# Required safety latch. Keep false until you are ready for a destructive load.
FULL_IMPORT_ALLOW_DESTRUCTIVE="false"

# Required only for reset_postgres_schema_via_tunnel.sh. Keep false unless the
# target schema must be dropped and rebuilt from Alembic head before the load.
FULL_IMPORT_ALLOW_SCHEMA_RESET="false"

# Optional: set to "false" if you already made a DB backup externally.
FULL_IMPORT_PG_BACKUP="true"
FULL_IMPORT_BACKUP_DIR="/Users/a_belianskii/projects/carcraft-leadgenerator/leasing_export/import/full_bulk_sql/backups"

# Postgres tunnel endpoint.
PGHOST="127.0.0.1"
PGPORT="15433"
PGDATABASE="CHANGE_ME"
PGUSER="CHANGE_ME"
PGPASSWORD="CHANGE_ME"

# Optional override. Usually leave empty.
POSTGRES_LOAD_SQL=""

# ClickHouse tunnel endpoint.
CH_HOST="127.0.0.1"
CH_PORT="19000"
CH_DATABASE="carcraft_dwh"
CH_USER="default"
CH_PASSWORD="CHANGE_ME"
CH_SECURE="false"

# Optional. Use when clickhouse-client is not installed but the single
# ClickHouse binary exists. The script will run it as: clickhouse client ...
CLICKHOUSE_CLIENT_BIN=""

# Optional override. Usually leave empty.
CH_DATA_DIR=""

# ClickHouse setting needed for large partitioned application rows.
FULL_IMPORT_CH_MAX_PARTITIONS_PER_INSERT_BLOCK="10000"
