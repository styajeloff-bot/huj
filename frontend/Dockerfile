FROM imbios/bun-node:latest-20.19.1-debian

WORKDIR /app

COPY . .

ARG NUXT_PUBLIC_API_BASE
ARG NUXT_PUBLIC_YANDEX_METRIKA_ENABLED=true
ARG NUXT_PUBLIC_YANDEX_METRIKA_ID=103750838
ARG NUXT_PUBLIC_VERBOX_ENABLED=true

ENV NODE_ENV=production
ENV NUXT_PUBLIC_API_BASE=${NUXT_PUBLIC_API_BASE}
ENV NUXT_PUBLIC_YANDEX_METRIKA_ENABLED=${NUXT_PUBLIC_YANDEX_METRIKA_ENABLED}
ENV NUXT_PUBLIC_YANDEX_METRIKA_ID=${NUXT_PUBLIC_YANDEX_METRIKA_ID}
ENV NUXT_PUBLIC_VERBOX_ENABLED=${NUXT_PUBLIC_VERBOX_ENABLED}

RUN bun ci
RUN bun run build:frontend

RUN mkdir -p /app/.nuxt /app/node_modules/.cache \
    && chown -R node:node /app/.nuxt /app/node_modules/.cache

USER node

EXPOSE 3000 3001

CMD ["bun", "run", "start:frontend"]
